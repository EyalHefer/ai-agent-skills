{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "profile-matcher",
  "input": {
    "type": "object",
    "required": ["instructions", "context", "items"],
    "properties": {
      "instructions": { "type": "string", "description": "File saying how to score" },
      "context": { "type": "array", "items": { "type": "string" }, "description": "Files with the profile, preferences and past ratings" },
      "fields": { "type": "string", "default": "title,company,text" },
      "max_chars": { "type": "integer", "default": 1500, "description": "Each field is cut to this length" },
      "items": { "description": "JSON array from stdin, or a rule-filter result object" }
    }
  },
  "output": {
    "type": "object",
    "required": ["scored", "unscored"],
    "additionalProperties": false,
    "properties": {
      "scored": {
        "type": "array",
        "description": "Sorted by score, highest first",
        "items": {
          "type": "object",
          "required": ["item", "score", "confidence", "why", "gaps"],
          "additionalProperties": false,
          "properties": {
            "item": { "type": "object" },
            "score": { "type": "integer", "minimum": 0, "maximum": 100 },
            "confidence": { "enum": ["high", "low"], "description": "low when the item gives too little information to judge" },
            "why": { "type": "string" },
            "gaps": { "type": "string", "description": "What the person is missing, empty if nothing" }
          }
        }
      },
      "unscored": { "type": "array", "items": { "type": "object" }, "description": "Items that could not be scored" }
    }
  }
}
