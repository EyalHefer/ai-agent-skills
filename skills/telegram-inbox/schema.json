{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "telegram-inbox",
  "input": {
    "type": "object",
    "required": [
      "command"
    ],
    "properties": {
      "command": {
        "enum": [
          "pull",
          "read",
          "events",
          "exports"
        ]
      },
      "inbox_dir": {
        "type": "string",
        "description": "pull, read, events: folder holding inbox.jsonl and events.jsonl"
      },
      "url": {
        "type": "string",
        "description": "pull, exports: the inbox Worker's base URL (or INBOX_URL)"
      },
      "since": {
        "type": "string",
        "format": "date-time",
        "description": "read: only postings sent at or after this time"
      },
      "exports_dir": {
        "type": "string",
        "description": "exports: folder to download the shared chat exports into"
      }
    }
  },
  "pull_output": {
    "type": "object",
    "required": [
      "pulled",
      "saved",
      "events"
    ],
    "properties": {
      "pulled": {
        "type": "integer",
        "description": "Posts fetched from the Worker and deleted there"
      },
      "saved": {
        "type": "integer",
        "description": "Of those, how many were new to inbox.jsonl"
      },
      "events": {
        "type": "integer",
        "description": "Feedback events new to events.jsonl"
      }
    }
  },
  "output": {
    "type": "array",
    "description": "read: the same format as whatsapp-export-reader",
    "items": {
      "type": "object",
      "required": [
        "key",
        "url",
        "title",
        "company",
        "text",
        "group",
        "sent_at"
      ],
      "additionalProperties": false,
      "properties": {
        "key": {
          "type": "string",
          "description": "Normalized URL, stable identity across sources and runs"
        },
        "url": {
          "type": "string",
          "description": "The link as posted"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "company": {
          "type": "string",
          "description": "Empty when the message does not name one"
        },
        "text": {
          "type": "string",
          "description": "The message text describing this job"
        },
        "group": {
          "const": "telegram-inbox"
        },
        "sent_at": {
          "type": "string",
          "format": "date-time",
          "description": "From the copied WhatsApp header, else when the bot received it"
        }
      }
    }
  },
  "events_output": {
    "type": "array",
    "items": {
      "type": "object",
      "required": [
        "update_id",
        "type",
        "message_id"
      ],
      "properties": {
        "update_id": {
          "type": "integer"
        },
        "type": {
          "enum": [
            "button",
            "reply"
          ]
        },
        "message_id": {
          "type": "integer",
          "description": "The bot message the feedback is about"
        },
        "choice": {
          "type": "string",
          "description": "button: the pressed button's callback data"
        },
        "text": {
          "type": "string",
          "description": "reply: the reply's text"
        },
        "date": {
          "type": "integer",
          "description": "Unix time"
        }
      }
    }
  },
  "exports_output": {
    "type": "object",
    "required": [
      "downloaded"
    ],
    "properties": {
      "downloaded": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    }
  }
}
